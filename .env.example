# Copy to .env and fill in. Never commit a real .env.

# NVIDIA NIM (AI code review + app AI) - free key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=z-ai/glm-5.3

# Optional / legacy integrations
OPENAI_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# App
PORT=9002
NODE_ENV=development
LOG_LEVEL=info
DEBUG=false
CACHE_DURATION_MS=300000
BACKEND_STRATEGY=

# Network (optional)
HTTP_PROXY=
HTTPS_PROXY=
PYRMETHUS_CONNECT_TIMEOUT=
PYRMETHUS_JOBS=
